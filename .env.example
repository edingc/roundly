# Copy to .env and adjust. Every value here has a working default for local
# development except JWT_SECRET, which is required when ENV=production.

# ---- Server ----
ADDR=:8080
ENV=development

# Where the browser reaches this instance. Used to send the user back to the app
# after the Google redirect, and it must match what you registered with Google.
PUBLIC_URL=http://localhost:8080

# Origins allowed to call the API with credentials. Only matters in development,
# where the Vite dev server is a different origin than the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Database ----
# Path to the SQLite file. It is created on first run and migrated automatically.
DATABASE_URL=roundly.db

# ---- Sessions ----
# REQUIRED in production, minimum 32 characters. Generate one with:
#   openssl rand -hex 32
# Changing it invalidates every existing access token.
JWT_SECRET=

# Access tokens are short-lived; refresh tokens are rotated on every use.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---- Google OAuth (optional) ----
# Leave blank to run password-only; the frontend hides the Google button.
#
# To enable, create your own OAuth client (free) at
# https://console.cloud.google.com/apis/credentials:
#   1. Create an OAuth 2.0 Client ID of type "Web application".
#   2. Add an authorized redirect URI exactly matching GOOGLE_REDIRECT_URL below.
#   3. Paste the client ID and secret here.
#
# Each self-hosted instance uses its own client. There is no shared auth server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the API's callback path, on the origin the browser uses:
#   production:  https://your-domain.example/api/auth/google/callback
#   development: http://localhost:5173/api/auth/google/callback  (via the Vite proxy)
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# ---- Administration ----
# The account allowed to remove courses and settle removal requests. Anyone can
# ask for a course to be removed; only this address can act on it. Leave unset
# and the instance has no administrator — requests queue and nothing is removed.
ADMIN_EMAIL=

# ---- API keys ----
# Personal read-only API keys are always available; these only tune the limits.
#
# Requests per key per window. A key is what a script holds, so it is the unit
# that can run away.
API_KEY_RATE_LIMIT=60
API_KEY_RATE_WINDOW=1m
# How many live keys one user may hold. Several is better than one: rotating a
# single key breaks every consumer at once.
API_KEY_MAX_PER_USER=10
