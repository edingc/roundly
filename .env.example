# Copy to .env and adjust. Every value here has a working default for local
# development except JWT_SECRET, which is required when ENV=production.

# ---- Server ----
ADDR=:8080
ENV=development

# Where the browser reaches this instance. Used to send the user back to the app
# after the Google redirect, and it must match what you registered with Google.
PUBLIC_URL=http://localhost:8080

# Origins allowed to call the API with credentials. Only matters in development,
# where the Vite dev server is a different origin than the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Database ----
# Path to the SQLite file. It is created on first run and migrated automatically.
DATABASE_URL=roundly.db

# ---- Sessions ----
# REQUIRED in production, minimum 32 characters. Generate one with:
#   openssl rand -hex 32
# Changing it invalidates every existing access token.
JWT_SECRET=

# Access tokens are short-lived; refresh tokens are rotated on every use.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---- Google OAuth (optional) ----
# Leave blank to run password-only; the frontend hides the Google button.
#
# To enable, create your own OAuth client (free) at
# https://console.cloud.google.com/apis/credentials:
#   1. Create an OAuth 2.0 Client ID of type "Web application".
#   2. Add an authorized redirect URI exactly matching GOOGLE_REDIRECT_URL below.
#   3. Paste the client ID and secret here.
#
# Each self-hosted instance uses its own client. There is no shared auth server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the API's callback path, on the origin the browser uses:
#   production:  https://your-domain.example/api/auth/google/callback
#   development: http://localhost:5173/api/auth/google/callback  (via the Vite proxy)
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# ---- Administration ----
# The account allowed to remove courses and settle removal requests. Anyone can
# ask for a course to be removed; only this address can act on it. Leave unset
# and the instance has no administrator — requests queue and nothing is removed.
ADMIN_EMAIL=

# ---- Course geocoding (optional) ----
# Fills a course's latitude and longitude from its address when they are left
# blank. Unset — the default — leaves both as hand-typed fields, which is how
# the app worked before this existed.
#
# Set it and this instance starts making outbound requests, sending course
# addresses to whoever runs that server. That is why it is opt-in.
#
# The public OpenStreetMap instance is free and needs no key:
#   NOMINATIM_URL=https://nominatim.openstreetmap.org
#
# Using it means accepting the OSM usage policy
# (https://operations.osmfoundation.org/policies/nominatim/). Roundly holds up
# its end — one request a second, results cached, this instance identified in
# the User-Agent via PUBLIC_URL, and no bulk geocoding on import — but the
# obligation is yours. Run your own copy if the directory ever gets busy; the
# same variable points at it.
#
# OSM data is ODbL, which permits storing the coordinates. The course form
# credits OpenStreetMap whenever this is enabled.
NOMINATIM_URL=

# ---- Email (optional) ----
# Unset — the default — and this instance cannot send mail. Two things are then
# switched off together: confirming an address at signup, and email two-factor
# on the profile screen. Nothing else changes, and neither feature is offered.
#
# Set MAIL_FROM plus exactly one transport. If both are configured, Resend wins.
#
# MAIL_FROM must be an address the transport is allowed to send as. On Resend
# that means a domain you have verified with them; on SMTP it usually means an
# address on the account you are authenticating with.
MAIL_FROM=

# -- Option 1: SMTP --
# Any mail server: a provider's relay, your own, or a local one. STARTTLS is
# used whenever the server offers it, and a remote server that does not offer it
# is refused rather than sent your password in the clear.
#
#   SMTP_HOST=smtp.fastmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@example.com
#   SMTP_PASSWORD=an-app-specific-password
#
# A local relay needs no credentials at all:
#   SMTP_HOST=localhost
#   SMTP_PORT=25
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# -- Option 2: Resend --
# An HTTPS API rather than SMTP, which is what to use on a host that blocks
# outbound 587 — a great many do. Get a key at https://resend.com/api-keys and
# verify the domain in MAIL_FROM.
RESEND_API_KEY=

# ---- Sign-in throttling ----
# Failed sign-in attempts allowed per account per window. The per-IP allowance
# is three times this, because one address can legitimately carry a household or
# an office behind it.
#
# Only failures count, so somebody who knows their password never runs into
# either limit however often they sign in.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=15m

# Accounts creatable from one address per window. This one counts *successes*
# as well as failures, because a successful signup is the thing being abused —
# filling an instance with junk accounts needs no failed attempts at all.
#
# Small and slow on purpose: real people sign up once. The default leaves room
# for a family or an office joining on the same evening and no more.
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW=1h

# ---- API keys ----
# Personal read-only API keys are always available; these only tune the limits.
#
# Requests per key per window. A key is what a script holds, so it is the unit
# that can run away.
API_KEY_RATE_LIMIT=60
API_KEY_RATE_WINDOW=1m
# How many live keys one user may hold. Several is better than one: rotating a
# single key breaks every consumer at once.
API_KEY_MAX_PER_USER=10
